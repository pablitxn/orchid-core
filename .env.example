# Security: Copy this file to .env and update with secure values
# NEVER commit the .env file to version control

# ─── Redis Configuration ────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_secure_password_123
REDIS_COMMANDER_PASSWORD=CHANGE_ME_commander_password_123

# ─── PostgreSQL Configuration ───────────────────────────────────────────────
POSTGRES_USER=orchid_admin
POSTGRES_PASSWORD=CHANGE_ME_postgres_secure_password_123
POSTGRES_DB=orchid_core

# ─── PgAdmin Configuration ──────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@yourdomain.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_pgadmin_secure_password_123

# ─── RabbitMQ Configuration ─────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=orchid_mq
RABBITMQ_DEFAULT_PASS=CHANGE_ME_rabbitmq_secure_password_123

# ─── Langfuse Configuration ─────────────────────────────────────────────────
LANGFUSE_DATABASE_PASSWORD=CHANGE_ME_langfuse_db_password_123
LANGFUSE_SALT=CHANGE_ME_generate_secure_random_salt
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME_generate_via_openssl_rand_hex_32
LANGFUSE_REDIS_AUTH=CHANGE_ME_langfuse_redis_password_123
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_nextauth_secret_123

# ─── ClickHouse Configuration ───────────────────────────────────────────────
CLICKHOUSE_PASSWORD=CHANGE_ME_clickhouse_password_123

# ─── MinIO Configuration ────────────────────────────────────────────────────
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_secure_password_123
