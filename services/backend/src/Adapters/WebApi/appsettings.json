{
  "_security_note": "Production values must be set via environment variables. See docs/deployment.md",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Warning",
      "Microsoft.AspNetCore.Http.Connections": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "MassTransit": "Warning"
    }
  },
  "FrontendUrl": "http://localhost:5173",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "AllowedHosts": "",
  "Authorization": {
    "Google": {
      "UserInfoUrl": "https://www.googleapis.com/oauth2/v1/userinfo"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "OpenAI": {
    "Endpoint": "https://api.openai.com/v1/chat/completions",
    "ApiKey": "",
    "Model": "gpt-5-nano-2025-08-07"
  },
  "Langfuse": {
    "BaseUrl": "http://localhost:3033/api/public",
    "Enabled": true,
    "PublicKey": "",
    "SecretKey": ""
  },
  "Redis": {
    "Configuration": "",
    "InstanceName": "ChatHistory:"
  },
  "FileStorage": {
    "Provider": "Local",
    "Bucket": "playground-bucket",
    "Path": "data"
  },
  "Auth": {
    "Provider": "generic"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "playground",
    "Audience": "playground",
    "ExpireHours": 4
  },
  "Auth0": {
    "_comment": "Auth0 is disabled when Domain is empty. Set via environment variables in production.",
    "Domain": "",
    "Audience": "https://api.orchid-core.com"
  },
  "TableDetection": {
    "MaxRetries": 3,
    "InputTokenCostPer1K": 0.01,
    "OutputTokenCostPer1K": 0.03,
    "MaxContextLength": 128000
  },
  "CreditSystem": {
    "TokensPerCredit": 100,
    "MinimumCreditsPerMessage": 1
  },
  "Sentry": {
    "_comment": "Set DSN via environment variable SENTRY__DSN in production",
    "Dsn": "",
    "TracesSampleRate": 0.1,
    "ProfilesSampleRate": 0.1
  },
  "Stripe": {
    "_comment": "Set Stripe API keys via environment variables in production: STRIPE__SECRETKEY, STRIPE__PUBLISHABLEKEY, STRIPE__WEBHOOKSECRET",
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": "",
    "BaseUrl": "http://localhost:5173"
  }
}
