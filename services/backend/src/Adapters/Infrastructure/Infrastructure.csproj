<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Disable auto-generation of assembly attributes to avoid duplicates with existing AssemblyInfo.cs -->
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <!-- Also disable target framework attribute generation to prevent duplicate TargetFrameworkAttribute -->
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <Nullable>enable</Nullable>
        <UserSecretsId>38c40e47-35e0-448b-8165-56129403f48a</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Application\Application.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.2" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.2" />
        <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.2" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.2" />
        <PackageReference Include="NCrontab" Version="3.4.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
        <PackageReference Include="Pgvector" Version="0.3.2" />
        <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.2.2" />
        <PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
        <PackageReference Include="MassTransit" Version="8.4.0" />
        <!-- Excel processing via EPPlus -->
        <PackageReference Include="EPPlus" Version="8.4.0" />
        <!-- Spreadsheet processing via Aspose.Cells -->
        <PackageReference Include="Aspose.Cells" Version="25.12.0" />
        <!-- HTTP client factory for Langfuse telemetry -->
        <!-- HTTP client factory for Langfuse telemetry -->
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
        <!-- Microsoft Agent Framework for AI integration -->
        <!-- Pinned preview version - track for GA release -->
        <PackageReference Include="Microsoft.Agents.AI" Version="1.0.0-preview.260108.1" />
        <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.0.0-preview.260108.1" />
        <PackageReference Include="Serilog" Version="4.3.0" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.0" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.0" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.10.0" />
        <PackageReference Include="StackExchange.Redis" Version="2.8.37" />
        <PackageReference Include="Google.Cloud.Storage.V1" Version="4.10.0" />
        <!-- Prometheus metrics for observability -->
        <PackageReference Include="prometheus-net" Version="8.2.1" />
        <!-- Stripe payment processing -->
        <PackageReference Include="Stripe.net" Version="47.4.0" />
        <!-- OpenAPI spec parsing for dynamic plugin integration -->
        <PackageReference Include="Microsoft.OpenApi" Version="1.6.23" />
        <PackageReference Include="Microsoft.OpenApi.Readers" Version="1.6.23" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Migrations\" />
    </ItemGroup>

</Project>

